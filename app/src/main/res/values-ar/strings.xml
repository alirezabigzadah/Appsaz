    <!-- الأسئلة -->
    <string-array name="faq_questions">
        <item>ما هو Appsaz؟</item>
        <item>هل أحتاج إلى معرفة البرمجة لاستخدام Appsaz؟</item>
        <item>ما أنواع التطبيقات التي يمكنني إنشاؤها باستخدام Appsaz؟</item>
        <item>هل يمكن بيع التطبيقات التي أنشأها؟</item>
        <item>هل يمكنني كسب المال باستخدام Appsaz؟</item>
        <item>هل Appsaz مجاني؟</item>
        <item>هل يمكنني إنشاء تطبيقات مصممة خصيصًا؟</item>
        <item>كيف يمكنني الاتصال بفريق الدعم؟</item>
    </string-array>

    <!-- الإجابات -->
    <string-array name="faq_answers">
        <item>Appsaz هو أداة مبتكرة لإنشاء تطبيقات أندرويد دون الحاجة إلى البرمجة. يوفر العديد من الميزات لتصميم وتطوير التطبيقات الوظيفية.</item>
        <item>لا، تم تصميم Appsaz لتمكين أي شخص من إنشاء تطبيقات بسهولة دون الحاجة إلى معرفة البرمجة مسبقًا.</item>
        <item>يمكنك إنشاء أنواع مختلفة من التطبيقات مثل التطبيقات الشخصية، القصصية، التعليمية، المعرض، الموسيقى، الفيديو والمزيد.</item>
        <item>نعم، يمكنك بيع التطبيقات التي تنشئها. يتيح لك Appsaz نشر تطبيقاتك على منصات مختلفة.</item>
        <item>نعم، يدعم Appsaz إعلانات AdMob، مما يتيح لك كسب المال من خلال الإعلانات. بالإضافة إلى ذلك، يمكنك بيع التطبيقات التعليمية التي تم إنشاؤها باستخدام Appsaz.</item>
        <item>الإصدار الأساسي من Appsaz مجاني. ومع ذلك، يمكنك الترقية إلى النسخة الاحترافية للحصول على ميزات متقدمة.</item>
        <item>نعم، يتيح لك Appsaz تخصيص التصميم والوظائف لتطبيقاتك كما تشاء.</item>
        <item>يمكنك الاتصال بفريق الدعم من خلال قسم "حول" في التطبيق أو عبر البريد الإلكتروني المقدم للدعم.</item>
    </string-array>

