    <!-- سوال‌ها -->
    <string-array name="faq_questions">
        <item>اپساز چیست؟</item>
        <item>آیا برای استفاده از اپساز نیاز به دانش برنامه‌نویسی دارم؟</item>
        <item>چه نوع اپلیکیشن‌هایی را می‌توانم با اپساز بسازم؟</item>
        <item>آیا می‌توانم اپلیکیشن‌هایی که می‌سازم را بفروشم؟</item>
        <item>آیا می‌توانم با استفاده از اپساز درآمد کسب کنم؟</item>
        <item>آیا اپساز رایگان است؟</item>
        <item>آیا می‌توانم اپلیکیشن‌های با طراحی سفارشی ایجاد کنم؟</item>
        <item>چگونه می‌توانم با تیم پشتیبانی تماس بگیرم؟</item>
    </string-array>

    <!-- پاسخ‌ها -->
    <string-array name="faq_answers">
        <item>اپساز یک ابزار نوآورانه برای ایجاد اپلیکیشن‌های اندروید است که نیاز به برنامه‌نویسی ندارد. این ابزار ویژگی‌های گسترده‌ای برای طراحی و توسعه اپلیکیشن‌های کاربردی ارائه می‌دهد.</item>
        <item>خیر، اپساز برای همه طراحی شده تا به‌راحتی بتوانند بدون دانش قبلی برنامه‌نویسی، اپلیکیشن خود را ایجاد کنند.</item>
        <item>شما می‌توانید انواع مختلف اپلیکیشن‌ها مانند شخصی، داستانی، آموزشی، گالری، موسیقی، ویدیو و موارد دیگر را ایجاد کنید.</item>
        <item>بله، شما می‌توانید اپلیکیشن‌هایی که می‌سازید را بفروشید. اپساز به شما امکان می‌دهد تا اپلیکیشن‌های خود را در پلتفرم‌های مختلف منتشر کنید.</item>
        <item>بله، اپساز از AdMob پشتیبانی می‌کند که به شما امکان می‌دهد از طریق تبلیغات درآمد کسب کنید. علاوه بر این، می‌توانید اپلیکیشن‌های آموزشی خود را نیز بفروشید.</item>
        <item>نسخه ابتدایی اپساز رایگان است. اما برای دسترسی به امکانات پیشرفته می‌توانید به نسخه حرفه‌ای ارتقاء دهید.</item>
        <item>بله، اپساز به شما امکان می‌دهد تا طراحی و عملکرد اپلیکیشن‌های خود را به‌طور کامل سفارشی کنید.</item>
        <item>شما می‌توانید از طریق بخش «درباره» در اپلیکیشن یا از طریق ایمیل پشتیبانی ارائه شده، با تیم پشتیبانی تماس بگیرید.</item>
    </string-array>

