<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:orientation="vertical">

    <include
         layout="@layout/toolbar" />

    <ScrollView
         android:layout_height="match_parent"
         android:layout_width="match_parent">

        <LinearLayout
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             android:padding="30dp"
             android:orientation="vertical">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:layout_margin="10dp"
                 android:text="@string/ads_admob"
                 android:textStyle="bold" />

            <View
                 android:layout_height="2dp"
                 android:layout_width="match_parent"
                 android:background="?android:attr/dividerVertical" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:layout_margin="10dp"
                 android:text="@string/ads_admob_application_id" />

            <TextView
                 android:layout_height="60dp"
                 android:layout_width="match_parent"
                 android:layout_centerInParent="true"
                 android:background="@drawable/row_bg"
                 android:gravity="fill"
                 android:paddingRight="20dp"
                 android:textSize="12sp"
                 android:paddingLeft="20dp"
                 android:typeface="monospace"
                 android:textStyle="italic"
                 android:id="@+id/ads_admob_application_id" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:layout_margin="10dp"
                 android:text="@string/ads_banner_ad"
                 android:textStyle="bold" />

            <View
                 android:layout_height="2dp"
                 android:layout_width="match_parent"
                 android:background="?android:attr/dividerVertical" />

            <com.google.android.material.materialswitch.MaterialSwitch
                 android:layout_height="60dp"
                 android:layout_width="match_parent"
                 android:background="@drawable/row_bg"
                 android:padding="20dp"
                 android:textSize="16sp"
                 android:layout_marginTop="10dp"
                 android:id="@+id/ads_banner_ad_switch"
                 android:text="@string/ads_banner_ad" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:layout_margin="10dp"
                 android:text="@string/ads_banner_ad_id" />

            <TextView
                 android:layout_height="60dp"
                 android:layout_width="match_parent"
                 android:layout_centerInParent="true"
                 android:background="@drawable/row_bg"
                 android:gravity="fill"
                 android:paddingRight="20dp"
                 android:textSize="12sp"
                 android:paddingLeft="20dp"
                 android:typeface="monospace"
                 android:textStyle="italic"
                 android:id="@+id/ads_banner_ad_id" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:layout_margin="10dp"
                 android:text="@string/ads_interstitial_ad"
                 android:textStyle="bold" />

            <View
                 android:layout_height="2dp"
                 android:layout_width="match_parent"
                 android:background="?android:attr/dividerVertical" />

            <RelativeLayout
                 android:layout_height="60dp"
                 android:layout_width="match_parent"
                 android:background="@drawable/row_bg"
                 android:layout_marginTop="10dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:clickable="true"
                     android:alpha="0.5"
                     android:layout_centerVertical="true"
                     android:padding="20dp"
                     android:textSize="16sp"
                     android:enabled="false"
                     android:text="@string/ads_interstitial_ad" />

                <ImageView
                     android:layout_height="50dp"
                     android:layout_width="50dp"
                     android:layout_centerInParent="true"
                     android:src="@drawable/ic_pro"
                     android:padding="10dp" />

            </RelativeLayout>

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:layout_margin="10dp"
                 android:text="@string/ads_interstitial_ad_id" />

            <TextView
                 android:layout_height="60dp"
                 android:layout_width="match_parent"
                 android:layout_centerInParent="true"
                 android:paddingRight="20dp"
                 android:textSize="12sp"
                 android:enabled="false"
                 android:typeface="monospace"
                 android:background="@drawable/row_bg"
                 android:gravity="fill"
                 android:alpha="0.5"
                 android:paddingLeft="20dp"
                 android:id="@+id/ads_interstitial_ad_id"
                 android:textStyle="italic"
                 android:text="ca-app-pub-3940256099942544/1033173712" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:layout_margin="10dp"
                 android:text="@string/ads_video_ad"
                 android:textStyle="bold" />

            <View
                 android:layout_height="2dp"
                 android:layout_width="match_parent"
                 android:background="?android:attr/dividerVertical" />

            <RelativeLayout
                 android:layout_height="60dp"
                 android:layout_width="match_parent"
                 android:background="@drawable/row_bg"
                 android:layout_marginTop="10dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:clickable="true"
                     android:alpha="0.5"
                     android:layout_centerVertical="true"
                     android:padding="20dp"
                     android:textSize="16sp"
                     android:enabled="false"
                     android:text="@string/ads_video_ad" />

                <ImageView
                     android:layout_height="50dp"
                     android:layout_width="50dp"
                     android:layout_centerInParent="true"
                     android:src="@drawable/ic_pro"
                     android:padding="10dp" />

            </RelativeLayout>

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:layout_margin="10dp"
                 android:text="@string/ads_video_ad_id" />

            <TextView
                 android:layout_height="60dp"
                 android:layout_width="match_parent"
                 android:layout_centerInParent="true"
                 android:paddingRight="20dp"
                 android:textSize="12sp"
                 android:enabled="false"
                 android:typeface="monospace"
                 android:background="@drawable/row_bg"
                 android:gravity="fill"
                 android:alpha="0.5"
                 android:paddingLeft="20dp"
                 android:id="@+id/ads_video_ad_id"
                 android:text="ca-app-pub-3940256099942544/8691691433"
                 android:textStyle="italic" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>