<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:orientation="vertical">

    <include
         layout="@layout/toolbar" />

    <RelativeLayout
         android:layout_height="match_parent"
         android:layout_width="match_parent">

        <ScrollView
             android:layout_height="match_parent"
             android:layout_width="match_parent">

            <RelativeLayout
                 android:layout_height="match_parent"
                 android:layout_width="match_parent"
                 android:padding="30dp">

                <LinearLayout
                     android:layout_height="match_parent"
                     android:layout_width="match_parent"
                     android:orientation="vertical">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:layout_margin="10dp"
                         android:text="@string/list_list" />

                    <View
                         android:layout_height="2dp"
                         android:layout_width="match_parent"
                         android:background="?android:attr/dividerVertical" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:layout_margin="10dp"
                         android:text="@string/list_background" />

                    <RelativeLayout
                         android:layout_height="60dp"
                         android:layout_width="match_parent"
                         android:background="@drawable/row_bg"
                         android:id="@+id/pageeditorPageBg">

                        <com.tistory.zladnrms.roundablelayout.RoundableLayout
                             android:layout_height="wrap_content"
                             android:layout_width="wrap_content"
                             app:cornerRightBottom="10dp"
                             app:cornerLeftSide="10dp"
                             android:layout_margin="5dp"
                             app:cornerLeftTop="10dp"
                             app:backgroundColor="#00ffffff"
                             app:cornerRightSide="10dp"
                             app:cornerLeftBottom="10dp"
                             app:cornerRightTop="10dp">

                            <ImageView
                                 android:layout_height="50dp"
                                 android:layout_width="50dp"
                                 android:scaleType="centerCrop"
                                 android:layout_margin="10dp"
                                 android:id="@+id/pageeditorPageBgImage" />

                        </com.tistory.zladnrms.roundablelayout.RoundableLayout>

                        <TextView
                             android:layout_height="wrap_content"
                             android:layout_width="match_parent"
                             android:layout_centerInParent="true"
                             android:textSize="16sp"
                             android:layout_marginRight="20dp"
                             android:layout_marginLeft="70dp"
                             android:layout_alignParentRight="true"
                             android:id="@+id/pageeditorPageBgText"
                             android:text="@string/a_color" />

                    </RelativeLayout>

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:layout_margin="10dp"
                         android:text="@string/list_items" />

                    <TextView
                         android:layout_height="60dp"
                         android:layout_width="match_parent"
                         android:background="@drawable/row_bg"
                         android:gravity="fill"
                         android:paddingRight="20dp"
                         android:textSize="16sp"
                         android:paddingLeft="20dp"
                         android:id="@+id/pageeditorContentEditorBtn"
                         android:text="@string/list_edit" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:layout_margin="10dp"
                         android:text="@string/list_toolbar" />

                    <View
                         android:layout_height="2dp"
                         android:layout_width="match_parent"
                         android:background="?android:attr/dividerVertical" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                         android:layout_height="60dp"
                         android:layout_width="match_parent"
                         android:background="@drawable/row_bg"
                         android:padding="20dp"
                         android:textSize="16sp"
                         android:textColor="@color/colorAccent"
                         android:layout_marginTop="10dp"
                         android:id="@+id/pageeditorTollbarSwitch"
                         android:text="@string/list_toolbar" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:layout_margin="10dp"
                         android:text="@string/list_title_toolbar" />

                    <TextView
                         android:layout_height="60dp"
                         android:layout_width="match_parent"
                         android:layout_centerInParent="true"
                         android:background="@drawable/row_bg"
                         android:gravity="fill"
                         android:paddingRight="20dp"
                         android:textSize="16sp"
                         android:paddingLeft="20dp"
                         android:layout_alignParentRight="true"
                         android:id="@+id/pageeditorTollbarTitle" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:layout_margin="10dp"
                         android:text="@string/list_toolbar_color" />

                    <RelativeLayout
                         android:layout_height="60dp"
                         android:layout_width="match_parent"
                         android:background="@drawable/row_bg"
                         android:id="@+id/pageeditorTollbarColor">

                        <com.tistory.zladnrms.roundablelayout.RoundableLayout
                             android:layout_height="wrap_content"
                             android:layout_width="wrap_content"
                             app:cornerRightBottom="10dp"
                             app:cornerLeftSide="10dp"
                             android:layout_margin="5dp"
                             app:cornerLeftTop="10dp"
                             app:backgroundColor="#00ffffff"
                             app:cornerRightSide="10dp"
                             app:cornerLeftBottom="10dp"
                             app:cornerRightTop="10dp">

                            <ImageView
                                 android:layout_height="50dp"
                                 android:layout_width="50dp"
                                 android:scaleType="centerCrop"
                                 android:layout_margin="10dp"
                                 android:id="@+id/pageeditorTollbarColorImage" />

                        </com.tistory.zladnrms.roundablelayout.RoundableLayout>

                        <TextView
                             android:layout_height="wrap_content"
                             android:layout_width="match_parent"
                             android:layout_centerInParent="true"
                             android:textSize="16sp"
                             android:layout_marginRight="20dp"
                             android:layout_marginLeft="70dp"
                             android:layout_alignParentRight="true"
                             android:text="@string/a_color" />

                    </RelativeLayout>

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:layout_margin="10dp"
                         android:text="@string/list_menu" />

                    <View
                         android:layout_height="2dp"
                         android:layout_width="match_parent"
                         android:background="?android:attr/dividerVertical" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                         android:layout_height="60dp"
                         android:layout_width="match_parent"
                         android:background="@drawable/row_bg"
                         android:padding="20dp"
                         android:textSize="16sp"
                         android:textColor="@color/colorAccent"
                         android:layout_marginTop="10dp"
                         android:id="@+id/pageeditorMenuSwitch"
                         android:text="@string/list_menu" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:layout_margin="10dp"
                         android:text="@string/list_menu_background" />

                    <RelativeLayout
                         android:layout_height="60dp"
                         android:layout_width="match_parent"
                         android:background="@drawable/row_bg"
                         android:id="@+id/pageeditorMenuBg">

                        <com.tistory.zladnrms.roundablelayout.RoundableLayout
                             android:layout_height="wrap_content"
                             android:layout_width="wrap_content"
                             app:cornerRightBottom="10dp"
                             app:cornerLeftSide="10dp"
                             android:layout_margin="5dp"
                             app:cornerLeftTop="10dp"
                             app:backgroundColor="#00ffffff"
                             app:cornerRightSide="10dp"
                             app:cornerLeftBottom="10dp"
                             app:cornerRightTop="10dp">

                            <ImageView
                                 android:layout_height="50dp"
                                 android:layout_width="50dp"
                                 android:scaleType="centerCrop"
                                 android:layout_margin="10dp"
                                 android:id="@+id/pageeditorMenuBgImage" />

                        </com.tistory.zladnrms.roundablelayout.RoundableLayout>

                        <TextView
                             android:layout_height="wrap_content"
                             android:layout_width="match_parent"
                             android:layout_centerInParent="true"
                             android:textSize="16sp"
                             android:layout_marginRight="20dp"
                             android:layout_marginLeft="70dp"
                             android:layout_alignParentRight="true"
                             android:id="@+id/pageeditorMenuBgText"
                             android:text="@string/a_color" />

                    </RelativeLayout>

                    <Space
                         android:layout_height="15dp"
                         android:layout_width="match_parent" />

                </LinearLayout>

            </RelativeLayout>

        </ScrollView>

    </RelativeLayout>

</LinearLayout>